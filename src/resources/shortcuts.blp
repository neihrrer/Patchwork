using Gtk 4.0;
using Adw 1;

Gtk.ShortcutsWindow {
  Gtk.ShortcutsSection {
    title: _("General");
    Gtk.ShortcutsShortcut {
      title: _("Open Image");
      accelerator: "<primary>o";
    }
    Gtk.ShortcutsShortcut {
      title: _("Export");
      accelerator: "<primary>s";
    }
    Gtk.ShortcutsShortcut {
      title: _("Quit");
      accelerator: "<primary>q";
    }
    Gtk.ShortcutsShortcut {
      title: _("Toggle Preview");
      accelerator: "<primary>p";
    }
  }
  Gtk.ShortcutsSection {
    title: _("Editing");
    Gtk.ShortcutsShortcut {
      title: _("Apply Filter");
      accelerator: "<primary>Return";
    }
    Gtk.ShortcutsShortcut {
      title: _("Reset Parameters");
      accelerator: "<primary>r";
    }
  }
  Gtk.ShortcutsSection {
    title: _("View");
    Gtk.ShortcutsShortcut {
      title: _("Before / After");
      accelerator: "<primary>t";
    }
    Gtk.ShortcutsShortcut {
      title: _("Zoom In");
      accelerator: "<primary>plus";
    }
    Gtk.ShortcutsShortcut {
      title: _("Zoom Out");
      accelerator: "<primary>minus";
    }
  }
}
