<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <object class="AdwWindow" id="window_root">
    <property name="title" translatable="yes">Ring</property>
    <property name="default-width">1100</property>
    <property name="default-height">750</property>
  </object>
  <object class="AdwBreakpoint" id="bp">
    <condition>max-width: 700sp</condition>
    <setter object="split_view" property="collapsed">true</setter>
  </object>
  <object class="AdwNavigationSplitView" id="split_view">
    <property name="sidebar">sidebar_page</property>
    <property name="content">content_page</property>
  </object>
  <object class="AdwNavigationPage" id="sidebar_page">
    <property name="title" translatable="yes">Nodes</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="sidebar-filter-headerbar"/>
            </style>
            <child type="start">
              <object class="GtkButton" id="open_button">
                <property name="icon-name">document-open-symbolic</property>
                <property name="tooltip-text" translatable="yes">Open Image</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="search_toggle">
                <property name="icon-name">system-search-symbolic</property>
                <property name="tooltip-text" translatable="yes">Search Filters</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <child>
              <object class="GtkRevealer" id="search_revealer">
                <property name="reveal-child">false</property>
                <property name="transition-type">5</property>
                <property name="child">
                  <object class="GtkSearchEntry" id="search_entry">
                    <property name="placeholder-text" translatable="yes">Search filters...</property>
                    <property name="margin-start">6</property>
                    <property name="margin-end">6</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="child">
                  <object class="GtkListView" id="filter_list">
                    <property name="vexpand">true</property>
                    <property name="hexpand">true</property>
                    <property name="show-separators">false</property>
                    <style>
                      <class name="filter-list"/>
                    </style>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwNavigationPage" id="content_page">
    <property name="title" translatable="yes">Node Editor</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="content_title">
                <property name="title" translatable="yes">Node Editor</property>
              </object>
            </property>
            <child type="start">
              <object class="GtkButton" id="render_button">
                <property name="label" translatable="yes">Render</property>
                <property name="sensitive">false</property>
              </object>
            </child>
                        <child type="end">
              <object class="GtkButton" id="export_button">
                <property name="icon-name">document-save-symbolic</property>
                <property name="tooltip-text" translatable="yes">Export Result</property>
                <property name="sensitive">false</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Menu</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <child>
              <object class="GtkRevealer" id="progress_revealer">
                <property name="reveal-child">false</property>
                <property name="transition-type">5</property>
                <property name="child">
                  <object class="GtkProgressBar" id="progress_bar">
                    <property name="show-text">false</property>
                    <style>
                      <class name="osd"/>
                    </style>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkPaned" id="output_paned">
                <property name="orientation">1</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="resize-start-child">true</property>
                <property name="resize-end-child">false</property>
                <property name="shrink-start-child">false</property>
                <property name="shrink-end-child">false</property>
                <child>
                  <object class="GtkBox" id="canvas_container">
                    <property name="orientation">1</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="output_box">
                    <property name="orientation">1</property>
                    <property name="hexpand">true</property>
                    <style>
                      <class name="output-panel"/>
                    </style>
                    <child>
                      <object class="GtkScrolledWindow" id="output_scrolled">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkTextView" id="output_text">
                            <property name="editable">false</property>
                            <property name="cursor-visible">false</property>
                            <property name="wrap-mode">3</property>
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <style>
                              <class name="output-text"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="status_box">
                <property name="orientation">0</property>
                <property name="spacing">6</property>
                <property name="margin-start">8</property>
                <property name="margin-end">8</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <child>
                  <object class="GtkLabel" id="status_label">
                    <property name="label" translatable="yes">No image loaded</property>
                    <property name="hexpand">true</property>
                    <property name="halign">1</property>
                    <property name="selectable">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinner" id="status_spinner">
                    <property name="spinning">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
