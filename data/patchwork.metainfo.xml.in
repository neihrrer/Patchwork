<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Patchwork</name>
  <summary>Node-based image editor powered by G'MIC and ImageMagick</summary>
  <description>
    <p>Patchwork is a modern GTK4/Libadwaita node-based image editor.</p>
    <p>Build image processing pipelines visually by connecting nodes. Powered by G'MIC (600+ filters) and ImageMagick (blend, color, mask operations).</p>
  </description>
  <url type="homepage">https://github.com/neihrrer/Patchwork</url>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <provides>
    <binary>patchwork</binary>
  </provides>
  <releases>
    <release version="@VERSION@" date="2026-07-09"/>
  </releases>
</component>
